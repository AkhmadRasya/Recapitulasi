APP_NAME="Kelurahan Sungai Andai"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-app.onrender.com

LOG_CHANNEL=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# Pilihan 1: Remote MySQL (misal dari Aiven / TiDB / Clever Cloud)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=recapitulasi
DB_USERNAME=root
DB_PASSWORD=

# Pilihan 2: SQLite (jika tidak menggunakan database server terpisah)
# DB_CONNECTION=sqlite

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
